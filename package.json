{
  "name": "renyiqian",
  "productName": "任意签",
  "version": "1.8.1",
  "description": "A floating desktop note app.",
  "main": "out/main/index.js",
  "author": "Ivan Yort <ivan.yort@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:root": "npm run build && electron --no-sandbox out/main/index.js",
    "start": "electron-vite preview",
    "start:root": "electron --no-sandbox out/main/index.js",
    "test": "node ./scripts/tests/run-electron-vitest.mjs run",
    "smoke:electron": "npm run build && node ./scripts/tests/smoke-electron-reminders.mjs",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage tar.gz --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:linux:ci": "npm run build && electron-builder --linux AppImage tar.gz --publish never",
    "dist:win:ci": "npm run build && electron-builder --win nsis --publish never",
    "release:version": "node scripts/release/next-version.mjs",
    "release:set-version": "node scripts/release/set-package-version.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.24",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
